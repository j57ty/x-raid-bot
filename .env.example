# ========================================================
# TELEGRAM BOT CONFIGURATION
# ========================================================
# Obtain your bot token by messaging @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ========================================================
# X (TWITTER) SESSION CREDENTIALS (Recommended / Free)
# ========================================================
# How to get auth_token & ct0 from your browser (burner account):
# 1. Log in to x.com on your browser (Chrome/Edge/Firefox)
# 2. Press F12 -> Go to 'Application' (or 'Storage') tab -> 'Cookies' -> https://x.com
# 3. Copy the values of 'auth_token' and 'ct0'
TWITTER_AUTH_TOKEN=your_x_auth_token_here
TWITTER_CT0=your_x_ct0_here

# Optional: Twitter Direct Login (alternative to cookies)
TWITTER_USERNAME=
TWITTER_PASSWORD=
TWITTER_EMAIL=

# Optional: Third-party API Key (e.g. from twitterapi.io)
TWITTERAPI_IO_KEY=

# ========================================================
# RAID & BOT SETTINGS
# ========================================================
# Default percentage of comments to pick (as requested: 40%)
DEFAULT_SAMPLE_PERCENT=40

# Only pick comments that gained traction (filters out zero-engagement comments before sampling)
FILTER_ZERO_TRACTION=true

# Maximum number of pages to scan for replies (each page has ~20-25 comments)
MAX_SCAN_PAGES=25

# Only include direct comments to the main tweet (excludes nested sub-replies to other users)
EXCLUDE_NESTED_REPLIES=true

# Number of comment targets assigned per group raider (default: 4)
TARGETS_PER_RAIDER=4

# Optional: Group Invite Link for welcome messages (auto-detected if empty)
GROUP_INVITE_LINK=

# Optional: Permanent roster of handles for /tagall and /raid (comma or space separated)
GROUP_MEMBERS=@user1, @user2, @user3

# Maximum number of comment links per Telegram message (chunks large lists)
MAX_LINKS_PER_MESSAGE=15

# Auto-delete non-admin warning message after N seconds (keeps group chat clean)
DELETE_WARNING_AFTER_SECONDS=8

# Pin raid announcements automatically in the group (requires bot to have pin privileges)
PIN_RAID_MESSAGE=true

# Test / Simulation Mode:
# When true (or if no X credentials are provided), simulates comment retrieval for testing
TEST_MODE=false
